{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"],
      "cache": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": true
    },
    "lint": {
      "outputs": []
    },
    "deploy:local": {
      "cache": false
    },
    "python:install": {
      "cache": true,
      "inputs": ["requirements.txt", "pyproject.toml"]
    },
    "python:test": {
      "dependsOn": ["python:install"],
      "cache": true
    },
    "python:build": {
      "dependsOn": ["python:install"],
      "outputs": ["dist/**"],
      "cache": true
    }
  }
}
